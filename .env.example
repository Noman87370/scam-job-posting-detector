# Copy to .env for local runs. NEVER commit a real .env with secrets.
# Production values are set in the hosting dashboard, not in this file.
#
# There is no database and no ingestion endpoint/token any more: the
# job feed is fetched server-side from the Arbeitnow API on demand and
# held in an in-memory cache (see backend/feed.py).

# Model artifacts directory (default: ./model).
MODEL_DIR=

# Built frontend directory served by the backend (default: ./backend/static).
FRONTEND_DIR=

# Max Arbeitnow API pages per upstream fetch (300 jobs per page).
ARBEITNOW_MAX_PAGES=3

# In-memory feed cache lifetime, in seconds (default 600 = 10 minutes).
FEED_CACHE_TTL_SECONDS=600
