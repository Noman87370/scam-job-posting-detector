# Copy to .env for local runs. NEVER commit a real .env with secrets.
# Production values are set in the hosting dashboard, not in this file.

# Database: SQLite file by default; set a Postgres URL in production.
# DATABASE_URL=postgresql://user:password@host:5432/scam_jobs
DATABASE_URL=

# Shared secret for POST /api/jobs/ingest (also used by the GitHub
# Actions cron). Leave empty locally to disable the endpoint.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
INGEST_TOKEN=

# Model artifacts directory (default: ./model).
MODEL_DIR=

# Built frontend directory served by the backend (default: ./backend/static).
FRONTEND_DIR=

# In-process ingestion every N minutes (default 30). Set RUN_SCHEDULER=false
# to disable it (e.g. when only the GitHub Actions cron should trigger it).
RUN_SCHEDULER=true
INGEST_INTERVAL_MINUTES=30

# Max Arbeitnow API pages per ingest run (300 jobs per page).
ARBEITNOW_MAX_PAGES=10
